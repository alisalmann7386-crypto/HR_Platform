# No API is required for extractive policy answers and template interviews.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# OpenAI-compatible endpoint; set for provider=compatible.
LLM_BASE_URL=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# semantic is preferred. lexical is an explicit, visibly labeled offline fallback.
EMBEDDING_BACKEND=semantic
RAG_TOP_K=6
RAG_CHUNK_SIZE=140
RAG_CHUNK_OVERLAP=25
RAG_MIN_SIMILARITY=0.30
